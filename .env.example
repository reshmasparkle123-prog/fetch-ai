# RationSeva agents - copy to .env and fill in. NEVER commit .env (it holds the seeds).
# `python scripts/setup_env.py` creates .env from this file, generates any missing seeds
# and fills in the *_ADDRESS values derived from them.

# RationSeva FastAPI backend (Cloudinary notice / scale-check / proof)
BACKEND_URL=https://ration-seva.onrender.com

# Agent seeds - secret. Same seed = same agent address. Keep the seed of an agent
# already registered on Agentverse to keep its address.
RATION_COORDINATOR_SEED=
RATION_VALIDATOR_SEED=
SHORTAGE_ANALYST_SEED=
NOTICE_AGENT_SEED=
WEIGHING_AGENT_SEED=

# Addresses of the internal agents (used by the Coordinator)
STOCK_VALIDATOR_ADDRESS=
SHORTAGE_ANALYST_ADDRESS=
NOTICE_AGENT_ADDRESS=
WEIGHING_AGENT_ADDRESS=

# true = connect through an Agentverse mailbox; false = local endpoint http://127.0.0.1:<port>/submit
# The Coordinator needs a mailbox to be reachable from ASI:One. The local test sets it to false.
COORDINATOR_MAILBOX=true
VALIDATOR_MAILBOX=false
SHORTAGE_ANALYST_MAILBOX=false
NOTICE_AGENT_MAILBOX=false
WEIGHING_AGENT_MAILBOX=false

# Timeouts (seconds): Coordinator -> agent, and agent -> backend per attempt
AGENT_TIMEOUT=30
BACKEND_TIMEOUT=25
